<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only test hooks; not present in release builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.DebugCommandReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver"
            xmlns:tools="http://schemas.android.com/tools">
            <intent-filter>
                <action android:name="com.asterix.voiceplayer.debug.SPEECH" />
                <action android:name="com.asterix.voiceplayer.debug.RECOGNIZE_WAV" />
                <action android:name="com.asterix.voiceplayer.debug.IMPORT" />
                <action android:name="com.asterix.voiceplayer.debug.STATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
